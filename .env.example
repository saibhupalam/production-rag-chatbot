# Application Configuration
PROJECT_NAME="ContextIQ"
API_V1_STR="/api/v1"
DEBUG=false

# Relational Database (PostgreSQL)
# When running locally outside Docker, use host "localhost" and port "5432"
# When running in Docker Compose, use host "postgres" and internal port "5432"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=rag_chatbot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Configurable host port mapping for Docker Compose to avoid conflicts with local PostgreSQL:
POSTGRES_HOST_PORT=5433

# Vector Database (Qdrant)
# When running locally, use host "localhost"
# When running in Docker Compose, use host "qdrant"
QDRANT_HOST=localhost
QDRANT_PORT=6333

# LLM Provider (Groq)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Authentication & Security (Phase 13)
SECRET_KEY=change_this_to_a_random_32_character_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# RAG & Ingestion Limits (Phase 12 & 14)
MAX_FILE_SIZE_MB=25
RAG_RETRIEVAL_LIMIT=5
RERANKING_ENABLED=true
SEMANTIC_CHUNKING_ENABLED=true
QUERY_REWRITE_ENABLED=true

# Frontend Configuration
BACKEND_URL=http://localhost:8000
